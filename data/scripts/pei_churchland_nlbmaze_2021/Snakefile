######################################################
# NLB MC Maze (2022)
######################################################

DATASET = "pei_churchland_nlbmaze_2021"
DATASET_ON_FOLDER = "mc_maze"
DANDI_ID = "000128"
FILENAME = "sub-Jenkins/sub-Jenkins_ses-full_desc-train_behavior+ecephys.nwb"

RAW_DIR = config["RAW_DIR"]
PROCESSED_DIR = config["PROCESSED_DIR"]
COMPRESSED_DIR = config["COMPRESSED_DIR"]


rule all:
    input:
        f"{PROCESSED_DIR}/{DATASET}/description.mpk"

rule download_dataset:
   output:
       nwb_file = f"{RAW_DIR}/{DATASET}/{DANDI_ID}/{FILENAME}"
   shell:
       f"""
       mkdir -p {RAW_DIR}/{DATASET}
       dandi download -o {RAW_DIR}/{DATASET} -e refresh DANDI:000128/0.220113.0400
       """

rule prepare_data:
    input:
        py_script = f"data/scripts/{DATASET}/prepare_data.py",
        nwb_file = f"{RAW_DIR}/{DATASET_ON_FOLDER}/{DANDI_ID}/{FILENAME}"
    output:
        description = f"{PROCESSED_DIR}/{DATASET}/description.mpk"
    shell:
        f"""
        mkdir -p {PROCESSED_DIR}/{DATASET}
        python data/scripts/{DATASET}/prepare_data.py --input_dir {RAW_DIR}/{DATASET_ON_FOLDER} --output_dir {PROCESSED_DIR}/{DATASET}
        """

include: "../freeze.smk"